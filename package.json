{
  "name": "nextintl-injector",
  "version": "0.1.0",
  "description": "A static text extractor and injector for Next.js + next-intl.",
  "type": "module",
  "bin": {
    "nextintl-injector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src --format esm --dts --watch",
    "prepare": "pnpm run build",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "Raffortville",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/generator": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "prettier": "^3.7.4",
    "zod": "^4.2.1"
  }
}
