{
  "name": "nextintl-injector",
  "version": "1.0.0",
  "description": "A static text extractor and injector for Next.js + next-intl.",
  "type": "module",
  "bin": {
    "nextintl-injector": "./bin/nextintl-injector"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup src --format esm --dts --clean",
    "dev": "tsup src --format esm --dts --watch",
    "prepare": "npm run build",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "Raffortville",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@types/node": "^25.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "prettier": "^3.7.4"
  }
}
